{
  "name": "garagem-aco/academia",
  "description": "Sistema web de gestão da Academia Garagem Aço.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Academia\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "migrate": "php bin/migrate.php",
    "create-admin": "php bin/create-admin.php",
    "processar-vencimentos": "php bin/processar-vencimentos.php",
    "gerar-mensalidades": "php bin/gerar-mensalidades.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
