APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/academia/public
APP_NAME="Academia Garagem Aço"
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt-BR

DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=academia_garagem_aco
DB_USERNAME=academia
DB_PASSWORD=troque_esta_senha_local
DB_SSLMODE=prefer

SESSION_NAME=academia_session
SESSION_LIFETIME=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Serviço local de WhatsApp Web; o token é gerado em storage/whatsapp, fora do Git.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
